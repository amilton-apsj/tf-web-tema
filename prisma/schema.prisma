datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Model Nutricionista
model Nutricionista {
  id           Int        @id @default(autoincrement())
  nome         String
  crn          String     @unique
  email        String     @unique
  senhaHash    String
  cardapios    Cardapio[] // Se deletar Nutricionista, apaga seus cardápios
  criadoEm     DateTime   @default(now())
  atualizadoEm DateTime   @updatedAt
}

// Model Cardapio
model Cardapio {
  id              Int            @id @default(autoincrement())
  data            DateTime
  tipo_refeicao   String
  horario_inicio  String
  horario_fim     String
  nutricionistaId Int
  nutricionista   Nutricionista  @relation(fields: [nutricionistaId], references: [id], onDelete: Cascade)
  itens           ItemCardapio[]
  criadoEm        DateTime       @default(now())
  atualizadoEm    DateTime       @updatedAt
}

// Model Categoria
model Categoria {
  id           Int            @id @default(autoincrement())
  nome         String         @unique
  itens        ItemCardapio[] // Se deletar Categoria, apaga os itens associados a ela
  criadoEm     DateTime       @default(now())
  atualizadoEm DateTime       @updatedAt
}

// Model Restricao
model Restricao {
  id           Int            @id @default(autoincrement())
  nome         String         @unique
  itens        ItemCardapio[]
  criadoEm     DateTime       @default(now())
  atualizadoEm DateTime       @updatedAt
}

// Model ItemCardapio
model ItemCardapio {
  id            Int         @id @default(autoincrement())
  nome_alimento String
  categoriaId   Int
  categoria     Categoria   @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  restricoes    Restricao[]
  cardapios     Cardapio[]
  criadoEm      DateTime    @default(now())
  atualizadoEm  DateTime    @updatedAt
}