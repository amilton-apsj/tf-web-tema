datasource db {
  provider = "postgresql" 
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Model Nutricionista 
model Nutricionista {
  id           Int        @id @default(autoincrement())    // PK, gerado automaticamente
  nome         String                                      // obrigatório
  crn          String     @unique                          // obrigatório e único
  email        String     @unique                          // obrigatório e único
  senhaHash    String                                      // hash da senha (nunca retornado pela API)
  cardapios    Cardapio[]                                  // relação 1:N - um nutricionista gerencia muitos cardápios
  criadoEm     DateTime   @default(now())                  // data de criação automática
  atualizadoEm DateTime   @updatedAt                       // data de atualização automática
}

// Model Cardapio 
model Cardapio {
  id              Int            @id @default(autoincrement())      // PK, gerado automaticamente
  data            DateTime                                          // obrigatório (data de exibição no calendário)
  tipo_refeicao   String                                            // obrigatório (ex: "Almoço" ou "Café da Manhã")
  horario_inicio  String                                            // obrigatório (ex: "11:15")
  horario_fim     String                                            // obrigatório (ex: "13:45")
  nutricionistaId Int                                               // FK, referência ao Nutricionista
  nutricionista   Nutricionista  @relation(fields: [nutricionistaId], references: [id]) // relação
  itens           ItemCardapio[]                                    // relação N:M - um cardápio tem muitos itens
  criadoEm        DateTime       @default(now())                    // data de criação automática
  atualizadoEm    DateTime       @updatedAt                         // data de atualização automática
}

// Model ItemCardapio 
model ItemCardapio {
  id            Int        @id @default(autoincrement())            // PK, gerado automaticamente
  categoria     String                                              // obrigatório (ex: "Salada", "Prato Principal")
  nome_alimento String                                              // obrigatório (ex: "Quibe", "Banana")
  restricoes    String?                                             // opcional (ex: "Vegano", "Contém Lactose")
  cardapios     Cardapio[]                                          // relação N:M - um item pode estar em vários cardápios
  criadoEm      DateTime   @default(now())                          // data de criação automática
  atualizadoEm  DateTime   @updatedAt                               // data de atualização automática
}